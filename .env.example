# Health and catalog run without credentials. Copy to .env for local configuration.
APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend-only parser credentials; optional for health/catalog startup.
OPENAI_API_KEY=
OPENAI_MODEL=
# Database integration remains pending; never commit real credentials.
DATABASE_URL=
# Backend-only Sandbox credentials. Optional for evidence; required for checkout. Live URLs rejected.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Public client ID only, reserved for buyer UI. Never add a public client SECRET.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Private single-buyer Sandbox demo. Off until explicitly configured.
RYUK_DEMO_ENABLED=false
# Required when enabled; choose a unique password of at least 16 characters.
RYUK_DEMO_PASSWORD=
RYUK_APP_ORIGIN=http://localhost:3000
# Set false ONLY for local HTTP development; HTTPS must use true.
RYUK_SECURE_COOKIES=true
# Local Python runtime path; Compose uses its protected /app/data volume.
RYUK_CHECKOUT_DB_PATH=./data/ryuk.sqlite3
RYUK_BUDGET_LIMIT_MINOR=150000
# Actual supported Sandbox seller ID, never a fictional hotel merchant identifier.
PAYPAL_MERCHANT_ID=
# Next server only; Compose sets http://backend:8000.
RYUK_BACKEND_URL=http://127.0.0.1:8000

# Backend-only alternative parser; strict structured-output-capable model required.
LLM_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=

# Private backend/frontend proxy channel; generate a unique 32+ character random value.
# Required for login through Compose ingress. Never use a NEXT_PUBLIC variable.
RYUK_PROXY_SHARED_SECRET=
